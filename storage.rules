rules_version = '2';

// Firebase Storage — Dashboard D07 Mới.
// File memo (PDF gốc + ảnh từng trang) nằm dưới memos/{memoId}/...
// AI CŨNG ĐỌC ĐƯỢC (kể cả chưa đăng nhập — Lan chốt 08/11/2026: ai cũng
// xem được memo; việc "đăng nhập mới tải được" do giao diện app kiểm
// soát, không khoá ở tầng Storage); chỉ Admin chính (admin@d07.com)
// ghi/xoá. Lan cần publish file này ở Firebase Console (Storage → Rules).
service firebase.storage {
  match /b/{bucket}/o {
    match /memos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == 'admin@d07.com';
    }

    // Avatar TVV nằm ở avatars/{uid}.jpg (uid = Firebase Auth uid của
    // chính TVV). AI CŨNG ĐỌC ĐƯỢC (avatar hiện ở trang cá nhân + hàng
    // của chính mình bên Tinh Anh); chỉ CHÍNH user mới ghi/xoá được file
    // của mình. Lan publish bản này CÙNG đợt với rules Memo ở trên.
    match /avatars/{userId}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
