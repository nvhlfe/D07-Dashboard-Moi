rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Báo cáo doanh số theo tháng (Sales Report)
    // Chỉ user đã đăng nhập (Firebase Auth) mới được đọc/ghi.
    match /reports/{reportId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Danh sách TVV dùng chung (upload qua nút "📥 Nhập data"), dùng cho picker "+TVV"
    match /tvv_directory/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Nhật ký thao tác — chỉ được thêm mới, không cho sửa/xoá để đảm bảo tính toàn vẹn audit trail
    match /audit_log/{logId} {
      allow read:          if request.auth != null;
      allow create:        if request.auth != null;
      allow update, delete: if false;
    }

    // ManMark — cam kết tuần/tháng + ghi chú, 1 document mỗi tháng (id kiểu "2026-9")
    match /manmark/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Pending Cases — theo dõi hồ sơ đang chờ, 1 document duy nhất ("main"), realtime nhiều máy
    match /pending_cases/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // TVV Hàng Ngày — snapshot lũy kế theo ngày từ file Daily Sales (Proposal/Agent/Leader/Pending/Pipeline)
    // Đây cũng là nguồn "chính thức" mà ManMark có thể đọc trực tiếp (tuỳ chọn "Nguồn thực đạt")
    match /daily_sales_tvv/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Hồ sơ cá nhân của từng user (Dashboard D07 Mới — cá nhân hoá theo TVV
    // + trạng thái duyệt tài khoản status: pending/approved/blocked):
    // user chỉ đọc/ghi hồ sơ của chính mình; Admin chính (admin@d07.com)
    // đọc/ghi được mọi hồ sơ để duyệt/khoá/thu hồi tài khoản TVV.
    match /user_profiles/{uid} {
      allow read: if request.auth != null
                    && (request.auth.uid == uid || request.auth.token.email == 'admin@d07.com');
      allow create, update: if request.auth != null
                    && (request.auth.uid == uid || request.auth.token.email == 'admin@d07.com');
      allow delete: if request.auth != null && request.auth.token.email == 'admin@d07.com';
    }

    // Điều chỉnh hồ sơ của Sales Report (Dashboard D07 Mới) — user đã đăng nhập mới được dùng
    match /case_adjustments/{docId} {
      allow read, write: if request.auth != null;
    }

    // Thư viện Memo · Thi đua · Tài liệu (Dashboard D07 Mới): metadata memo,
    // file nằm ở Firebase Storage (xem storage.rules). AI CŨNG ĐỌC ĐƯỢC
    // (kể cả chưa đăng nhập — Lan chốt 08/11/2026: ai cũng xem được memo,
    // việc "đăng nhập mới tải được" do giao diện app kiểm soát); chỉ Admin
    // chính (admin@d07.com) tạo/sửa/xoá.
    match /memos/{memoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                    && request.auth.token.email == 'admin@d07.com';
    }

    // Mặc định: từ chối tất cả những gì không khớp rule ở trên
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
